"public_settings.tunnel" = "Tunnel connection";
"public_settings.tunnel_failure.atc_probe" = "The AirLift route connected, but ATC is not ready. Stop AirLift operations in other apps, reconnect LocalDevVPN, then tap the tunnel status to retry. The log identifies the route and failed ATC step.";
"public_settings.tunnel_failure.books_manifest_stalled" = "The connection works, but the iPhone did not answer the Books sync step (AssetManifest) and let the session time out. Open Apple Books once (make sure it is installed, not offloaded), keep the iPhone unlocked with 3105 in the foreground, turn off Wi-Fi sync with Finder/iTunes, restart the iPhone, then retry.";
"public_settings.tunnel_failure.endpoint_refused" = "AirLift port 10.7.0.1:49152 refused the connection. A pairing file is saved, but live pairing has not been verified. Open LocalDevVPN, confirm it is connected and Device IP is 10.7.0.1; reconnect it, disable other VPNs, then check again. No need to re-import pairing yet.";
"public_settings.tunnel_failure.endpoint_timeout" = "The AirLift connection timed out. Check Wi-Fi, LocalDevVPN, and Device IP 10.7.0.1, then reconnect the VPN and retry. This does not establish that pairing is invalid.";
"public_settings.tunnel_failure.endpoint_unreachable" = "There is no network path to the AirLift port. Check Wi-Fi and LocalDevVPN, then retry. This does not establish that pairing is invalid.";
"public_settings.tunnel_failure.listener_refused" = "Pairing connected, but the dynamic tunnel port refused the attempted routes. Reconnect LocalDevVPN, keep Wi-Fi on, and retry. If it persists, reinstall LocalDevVPN, restart the phone, and export the log.";
"public_settings.tunnel_failure.listener_timeout" = "Tunnel creation timed out. Reconnect LocalDevVPN, keep Wi-Fi on, and retry. The log records the failed stage and unresponsive addresses.";
"public_settings.tunnel_failure.lockdown_host_rejected" = "This iPhone rejected the pairing file (InvalidHostID): the file was made for another computer or iPhone, or this iPhone's Trust settings were reset. Plug the iPhone into the computer, create a new file with 3105 PairingBridge (USB pairing), and import it again.";
"public_settings.tunnel_failure.lockdown_record_required" = "On iOS below 26.4, AirLift needs a classic Lockdown pairing file. The imported file is RPPairing, which only works on iOS 26.4 and later. Plug the iPhone into a computer, create the file with 3105 PairingBridge (USB pairing), and import it again.";
"public_settings.tunnel_failure.pairing_file" = "The pairing file is missing or unreadable. Import a pairing file created for this iPhone.";
"public_settings.tunnel_failure.pairing_or_rsd" = "The endpoint responded, but the RSD session could not open. Check LocalDevVPN; if it still fails, create and import a new pairing file for this iPhone, then review the log.";
"public_settings.tunnel_failure.pairing_verify" = "The pairing session could not be verified. Check that the pairing file belongs to this iPhone, reconnect LocalDevVPN, and retry. If it persists, recreate pairing and export the log.";
"public_settings.tunnel_failure.rsd_unreachable" = "No RSD endpoint answered. Check Wi-Fi, reconnect LocalDevVPN, and retry. The log records each address and network error; this does not establish that pairing is invalid.";
"public_settings.tunnel_failure.service_map" = "RSD connected, but ATC or ZIP is missing from its service map. This does not prove pairing is invalid. Reconnect LocalDevVPN and export the log to check support on this iOS build.";
"public_settings.tunnel_failure.tunnel_handshake" = "The tunnel port answered, but the secure handshake failed. Reconnect LocalDevVPN and retry; export the log if it persists so pairing and tunnel failures can be checked.";
"public_settings.tunnel_failure.unknown" = "The failed connection stage is not yet clear. Check again and export the 3105 log for the error code.";
"public_settings.tunnel_failure.vpn_conflict" = "Another VPN is active. iOS allows only one VPN at a time. Disconnect the other VPN first, then enable LocalDevVPN and check again.";
"public_settings.tunnel_failure.vpn_off" = "LocalDevVPN is not connected: 10.7.0.1 answered neither the RSD nor the Lockdown port. Open LocalDevVPN, tap Connect, wait until it shows Connected, then check again. The pairing file is not the problem.";
"public_settings.tunnel_failure.zip_probe" = "The AirLift route connected, but ZIP did not respond correctly. Reconnect LocalDevVPN, then tap the tunnel status to retry. Export the log if it still fails.";
