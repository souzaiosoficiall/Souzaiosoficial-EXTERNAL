"public_settings.tunnel_failure.endpoint_refused" = "Cổng AirLift 10.7.0.1:49152 đang từ chối kết nối. File pairing đã được lưu nhưng chưa thể kiểm chứng. Mở LocalDevVPN, xác nhận VPN đang kết nối và Device IP là 10.7.0.1; ngắt/kết nối lại VPN, tắt VPN khác rồi kiểm tra lại. Chưa cần nhập lại pairing.";
"public_settings.tunnel_failure.endpoint_timeout" = "Kết nối tới AirLift bị quá thời gian. Kiểm tra Wi-Fi, LocalDevVPN và cấu hình Device IP 10.7.0.1, sau đó kết nối lại VPN và thử lại. Chưa thể kết luận pairing sai.";
"public_settings.tunnel_failure.endpoint_unreachable" = "Máy không có đường mạng tới cổng AirLift. Kiểm tra Wi-Fi và LocalDevVPN đang kết nối, rồi thử lại. Chưa thể kết luận pairing sai.";
"public_settings.tunnel_failure.listener_refused" = "Đã kết nối pairing nhưng cổng tunnel động từ chối các đường kết nối đã thử. Kết nối lại LocalDevVPN, giữ Wi-Fi bật rồi thử lại. Nếu vẫn lỗi, hãy xoá và cài lại LocalDevVPN, khởi động lại máy và gửi Nhật ký.";
"public_settings.tunnel_failure.listener_timeout" = "Quá thời gian tạo tunnel. Kết nối lại LocalDevVPN, giữ Wi-Fi bật rồi thử lại. Nhật ký ghi rõ bước và địa chỉ không phản hồi.";
"public_settings.tunnel_failure.lockdown_host_rejected" = "iPhone không nhận file pairing này (InvalidHostID): file tạo cho máy/iPhone khác, hoặc iPhone đã bị đặt lại Tin cậy. Cắm iPhone vào máy tính, tạo lại file bằng 3105 PairingBridge (ghép qua USB) rồi nhập lại.";
"public_settings.tunnel_failure.lockdown_record_required" = "iOS dưới 26.4 cần file pairing Lockdown cổ điển. File đang nhập là RPPairing, chỉ dùng được từ iOS 26.4 trở lên. Cắm iPhone vào máy tính, tạo file bằng 3105 PairingBridge (ghép qua USB) rồi nhập lại.";
"public_settings.tunnel_failure.pairing_file" = "Thiếu file pairing hoặc file không đọc được. Hãy nhập lại đúng file pairing được tạo cho iPhone này.";
