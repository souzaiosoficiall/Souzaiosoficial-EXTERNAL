"public_settings.tunnel_failure.service_map" = "Đã mở được tunnel RSD, nhưng thiếu dịch vụ ATC hoặc ZIP. Đây không phải bằng chứng pairing sai. Kết nối lại LocalDevVPN và xuất Nhật ký để kiểm tra khả năng hỗ trợ của iOS này.";
"public_settings.tunnel_failure.tunnel_handshake" = "Cổng tunnel đã phản hồi nhưng bắt tay bảo mật thất bại. Kết nối lại LocalDevVPN rồi thử lại; nếu vẫn lỗi hãy gửi Nhật ký để kiểm tra pairing và tunnel.";
"public_settings.tunnel_failure.unknown" = "Chưa xác định được bước kết nối bị lỗi. Hãy bấm kiểm tra lại và xuất Nhật ký 3105 để đối chiếu mã lỗi.";
"public_settings.tunnel_failure.vpn_conflict" = "Đang có VPN khác hoạt động. iOS chỉ cho phép một VPN cùng lúc. Hãy tắt VPN kia trước, rồi bật LocalDevVPN và kiểm tra lại.";
"public_settings.tunnel_failure.vpn_off" = "LocalDevVPN chưa kết nối (10.7.0.1 không trả lời cả cổng RSD lẫn Lockdown) — mở LocalDevVPN, bấm Connect, chờ hiện Connected rồi thử lại. File pairing không phải nguyên nhân.";
"public_settings.tunnel_failure.zip_probe" = "Đường truyền AirLift đã kết nối nhưng dịch vụ ZIP chưa phản hồi đúng. Kết nối lại LocalDevVPN rồi chạm vào trạng thái tunnel để thử lại; xuất Nhật ký nếu vẫn lỗi.";
